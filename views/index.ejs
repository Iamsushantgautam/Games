<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Games Home</title>
  <link rel="stylesheet" href="/style.css"/>
</head>
<body>

  <header>
    <h1>🎮 Welcome to GameZone</h1>
    <p>Choose a game to start playing!</p>
  </header>

  <div class="game-container">
    <div class="game-item">
      <a href="/tic-tac-toe">
        <img src="/Tic-Tac-Toe/images/logo.png" alt="Tic Tac Toe" class="game-image"/>
      </a>
      <p class="game-title">Tic Tac Toe</p>
    </div>

    <div class="game-item">
      <a href="/rock-paper-scissors">
        <img src="/rock-paper-scissors/images/logo.jpg" alt="Rock Paper Scissors" class="game-image"/>
      </a>
      <p class="game-title">Rock Paper Scissors</p>
    </div>

   <div class="game-item">
    <a href="/Memory-Match-Game">
      <img src="/Memory-Match-Game/images/logo.jpeg" alt="memory match game"  class="game-image"/>
    </a>
    <p class="game-title">Memory Match Game</p>
  
   </div>

  </div>

</body>
</html>
